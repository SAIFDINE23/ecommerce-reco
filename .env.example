# Ressources données à Spark. Copier ce fichier en .env et adapter à votre machine.
# Règle : SPARK_EXECUTOR_MEMORY < SPARK_WORKER_MEMORY, et le total
# (worker + driver + ~1,5 Go pour le master et Jupyter) doit rester sous la RAM de WSL.
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=3g
SPARK_EXECUTOR_MEMORY=2g
SPARK_DRIVER_MEMORY=1g